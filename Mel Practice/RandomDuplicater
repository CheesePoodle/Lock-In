global proc duplicateRandomly(int $minX, int $maxX, int $minY, int $maxY, int $minZ, int $maxZ, int $numDuplicates){
    string $selectedObjects[] = `ls -sl`;
    if (size($selectedObjects) == 0){
        error("No objects selected");
        return;
    }

    for ($i = 0; $i < $numDuplicates; $i++){
        for ($obj in $selectedObjects){
            string $newObj[] = `duplicate $obj`;
            float $randX = rand($minX, $maxX);
            float $randY = rand($minY, $maxY);
            float $randZ = rand($minZ, $maxZ);
            move -absolute $randX $randY $randZ $newObj[0];
        }
    }
}