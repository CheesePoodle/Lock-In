global proc addToArray(int $number)
{
    global int $inputArray[];
    global string $inputTextCtrl;

    // append
    intArrayInsertAtIndex(size($inputArray), $inputArray, $number);

    // build a label from the array
    string $s = "";
    for ($i = 0; $i < size($inputArray); $i++) {
        $s += ($inputArray[$i] + "");
        if ($i < size($inputArray)-1) $s += ", ";
    }

    // update the text control
    if (`objExists $inputTextCtrl`) {
        text -e -label $s $inputTextCtrl;
    }
}

global proc prntSelection()
{
    global string $rc;
    string $selCtrl = `radioCollection -q -select $rc`;   // returns control name
    string $label = `radioButton -q -label $selCtrl`;    // get the label text
    calculator($label, $inputArray);
}

showWindow $calcWindow;