global proc myFunction(){
    //Queries the inputted values and stores them in a variable
    float $xValMin = `floatField -q -v minXField`;
    float $xValMax = `floatField -q -v maxXField`;
    float $yValMin = `floatField -q -v minYField`;
    float $yValMax = `floatField -q -v maxYField`;
    float $zValMin = `floatField -q -v minZField`;
    float $zValMax = `floatField -q -v maxZField`;
    //selection of objects; returns a list of selected objects and stores in a variable
    string $selection[] = `ls -sl`;
    int $numVal = `intField -q -v numVal`; //number of duplicates
    print $numVal;
    
    if(size($selection) == 0){
        error("No objects selected");
        return;
    } else{
        for($i = 0; $i < size($selection); $i++){//for each selected object
            for($j = 0; $j < $numVal; $j++){//for the number of duplicates
                string $newObj[] = `duplicate $selection[$i]`;
                float $randXVal = randomNumber($xValMin, $xValMax);
                float $randYVal = randomNumber($yValMin, $yValMax);
                float $randZVal = randomNumber($zValMin, $zValMax);
                move ($randXVal) ($randYVal) ($randZVal) $newObj[0];
            }
            
            
        }
    }
}

global proc float randomNumber(float $min, float $max){
    return rand($min, $max);
}

string $mWindow = `window -title "ourWindow" -widthHeight 300 400`;
gridLayout -numberOfColumns 2 -cellWidthHeight 150 50;
    text -label "Number of Duplicates:";
    intField numVal;
    text -label "Min X:" -bgc 1 0 0;
    floatField minXField;
    text -label "Max X:" -bgc 1 0 0;
    floatField maxXField;
    text -label "Min Y:" -bgc 0 1 0;
    floatField minYField;
    text -label "Max Y:" -bgc 0 1 0;
    floatField maxYField;
    text -label "Min Z:" -bgc 0 0 1;
    floatField minZField;
    text -label "Max Z:" -bgc 0 0 1;
    floatField maxZField;
    button -label "run" -command "myFunction()";
showWindow $mWindow;